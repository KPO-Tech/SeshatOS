# SeshatOS — Environment Configuration
# Copy to .env and fill in your values.

# ─── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=INFO
SESHAT_DEBUG=false

# ─── Bootstrap Admin (first-run only) ──────────────────────────────────────────
SESHAT_ADMIN_EMAIL=admin@example.com
SESHAT_ADMIN_PASSWORD=changeme

# ─── Auth ──────────────────────────────────────────────────────────────────────
SESHAT_ENABLE_SIGNUP=true
SESHAT_ENABLE_API_KEYS=true

# ─── Connected mode ─────────────────────────────────────────────────────────────
# Not configurable here or via any environment variable. The backend checks,
# once at startup, whether the seshat-server hardcoded into
# internal/config/bootstrap.go (defaultServerURL) is reachable - connected
# mode (identity/settings/preferences delegated there) if so, standalone
# (local-only) otherwise. seshat-server access is Seshat's paid
# managed-service tier; there is deliberately no setting here that would let
# it be pointed at a different, self-hosted server.

# ─── Provider API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: automatic chat titles with a tiny local GGUF model.
# This does not require Ollama or a local server. It uses a llama.cpp-compatible
# executable and stores Hugging Face downloads under the Seshat runtime root.
# Example model source:
#   SESHAT_TITLE_LOCAL_HF_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
#   SESHAT_TITLE_LOCAL_HF_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
SESHAT_TITLE_LOCAL_ENABLED=false
SESHAT_TITLE_LOCAL_RUNTIME=llama.cpp
SESHAT_TITLE_LOCAL_EXECUTABLE=llama-cli
SESHAT_TITLE_LOCAL_MODEL_PATH=
SESHAT_TITLE_LOCAL_HF_REPO=
SESHAT_TITLE_LOCAL_HF_FILE=
SESHAT_TITLE_LOCAL_CACHE_DIR=
SESHAT_TITLE_LOCAL_TIMEOUT=30s

# Optional: provider-backed title model fallback. Leave empty to use the main model.
SESHAT_TITLE_MODEL=
SESHAT_TITLE_MODEL_BASE_URL=
SESHAT_TITLE_MODEL_API_KEY=

# ─── OAuth (optional — OpenAI device flow) ─────────────────────────────────────
# Register your own OAuth app at platform.openai.com and set the client ID here.
OPENAI_CLIENT_ID=

# ─── Web Search (pick one) ─────────────────────────────────────────────────────
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
SEARXNG_BASE_URL=

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero config):
SESHAT_DB_DRIVER=sqlite
SESHAT_DB_DSN=seshat.db
SESHAT_DB_AUTO_MIGRATE=true

# PostgreSQL (recommended for production):
# SESHAT_DB_DRIVER=postgres
# SESHAT_DB_DSN=postgresql://user:password@localhost:5432/nexus?sslmode=disable

# ─── RAG / Embedder (optional) ─────────────────────────────────────────────────
# Ollama (local, free):  ollama pull nomic-embed-text
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_URL=http://localhost:11434/v1
RAG_EMBEDDING_MODEL=nomic-embed-text

# OpenAI:
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_URL=https://api.openai.com/v1
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector Backend ────────────────────────────────────────────────────────────
SESHAT_VECTOR_BACKEND=sqlite
# pgvector:
# SESHAT_VECTOR_BACKEND=pgvector
# SESHAT_PGVECTOR_DSN=postgresql://user:password@localhost:5432/nexus?sslmode=disable

# ─── Storage ───────────────────────────────────────────────────────────────────
SESHAT_STORAGE_PROVIDER=local
SESHAT_STORAGE_LOCAL_PATH=./data/files

# S3 / MinIO:
# SESHAT_STORAGE_PROVIDER=s3
# SESHAT_STORAGE_S3_BUCKET=nexus
# SESHAT_STORAGE_S3_ENDPOINT=http://localhost:9000
# SESHAT_STORAGE_S3_ACCESS_KEY=
# SESHAT_STORAGE_S3_SECRET_KEY=
