{
  "name": "seshat-desktop",
  "version": "0.3.0",
  "description": "SeshatOS Desktop Client",
  "main": "out/main/index.js",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "author": {
    "name": "KPO-Tech",
    "email": "seshatsupport@seshat-ai.com"
  },
  "homepage": "https://seshat-ai.com/en",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node scripts/start-desktop-dev.mjs",
    "dev": "node scripts/start-desktop-dev.mjs",
    "dev:public": "node scripts/start-desktop-dev.mjs --edition=public",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint src",
    "ui-catalog": "node scripts/generate-ui-catalog.mjs",
    "test": "vitest run && npm run test:ipc",
    "test:watch": "vitest",
    "build:backend:win": "node ../scripts/build-desktop-sidecar.mjs windows amd64",
    "build:backend:linux": "node ../scripts/build-desktop-sidecar.mjs linux amd64",
    "build:backend:win:nativedoc": "node ../scripts/build-desktop-sidecar.mjs windows amd64 --nativedoc",
    "build:backend:linux:nativedoc": "node ../scripts/build-desktop-sidecar.mjs linux amd64 --nativedoc",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build:backend:win && npm run build && electron-builder --win nsis",
    "package:linux": "npm run build:backend:linux && npm run build && electron-builder --linux AppImage deb",
    "package:win:nativedoc": "npm run build:backend:win:nativedoc && npm run build && electron-builder --win nsis",
    "package:linux:nativedoc": "npm run build:backend:linux:nativedoc && npm run build && electron-builder --linux AppImage deb",
    "test:ipc": "tsc -p tsconfig.ipc-tests.json && node --test .tmp/ipc-tests/ipc/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.80",
    "@icon-park/react": "^1.4.2",
    "@seshat/connector-catalog": "file:../shared/connector-catalog",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@vitejs/plugin-react": "^4.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "pptx-preview": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-icons": "^16.31.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "build": {
    "appId": "com.seshat.os",
    "productName": "SeshatOS",
    "copyright": "Copyright © 2026 Stéphane Kpoviessi (Seshat)",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "node_modules/@anthropic-ai/sandbox-runtime",
        "to": "sandbox-runtime"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "SeshatOS-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "SeshatOS-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "license": "license.txt",
      "shortcutName": "SeshatOS",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KPO-Tech",
        "repo": "SeshatOS"
      }
    ]
  },
  "productName": "SeshatOS"
}
